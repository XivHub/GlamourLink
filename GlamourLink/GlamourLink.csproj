<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.5</Version>
    <PackageProjectUrl>https://github.com/XivHub/GlamourLink</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Glamourer.Api" Version="2.8.2" />
    <!-- Eorzea Collection sits behind a Cloudflare managed challenge that scores the TLS
         and HTTP/2 handshake. SocketsHttpHandler's handshake is refused; WinHttpHandler's,
         over HTTP/2, is not. See EorzeaCollectionClient for the measurements. -->
    <PackageReference Include="System.Net.Http.WinHttpHandler" Version="10.0.12" />
  </ItemGroup>
  <!-- Shared helpers compiled from source; see ~/dev/XivHubPluginKit/UI/THEME.md -->
  <ItemGroup>
    <Compile Include="..\..\XivHubPluginKit\UI\HubColors.cs" Link="Kit\UI\HubColors.cs" />
    <Compile Include="..\..\XivHubPluginKit\UI\HubStyle.cs" Link="Kit\UI\HubStyle.cs" />
    <Compile Include="..\..\XivHubPluginKit\UI\HubThemeConfig.cs" Link="Kit\UI\HubThemeConfig.cs" />
    <Compile Include="..\..\XivHubPluginKit\UI\HubThemeEditor.cs" Link="Kit\UI\HubThemeEditor.cs" />
    <Compile Include="..\..\XivHubPluginKit\UI\HubText.cs" Link="Kit\UI\HubText.cs" />
    <Compile Include="..\..\XivHubPluginKit\DevTelemetry.cs" Link="Kit\DevTelemetry.cs" />
  </ItemGroup>
</Project>
